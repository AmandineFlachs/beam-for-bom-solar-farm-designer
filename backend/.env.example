# Optional: real Beam agent. Any OpenAI-compatible endpoint works
# (Reflection AI or Hugging Face Inference). Leave unset for the
# deterministic offline Beam used in the demo fallback.
BEAM_API_BASE=https://api.example.com/v1
BEAM_API_KEY=sk-...
BEAM_MODEL=Beam-1.0-501B-A23B
# Beam always reasons; lower effort = lower latency (low|medium|high|xhigh|max)
BEAM_REASONING_EFFORT=medium
